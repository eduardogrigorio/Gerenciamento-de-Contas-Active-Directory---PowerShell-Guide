📝 Script Completo
powershell
<#
.SYNOPSIS
    Script para gerenciamento de contas AD
.DESCRIPTION
    Desbloqueia e habilita contas AD com verificação de status
.PARAMETER Username
    Nome do usuário para gerenciamento
.EXAMPLE
    .\Manage-ADAccount.ps1 -Username "joao.silva"
#>

param(
    [Parameter(Mandatory=$true)]
    [string]$Username
)

try {
    $user = Get-ADUser -Identity $Username -Properties LockedOut, Enabled, LastBadPasswordAttempt, BadLogonCount -ErrorAction Stop
    
    Write-Host "Status da conta $Username" -ForegroundColor Cyan
    Write-Host "LockedOut: $($user.LockedOut)"
    Write-Host "Enabled: $($user.Enabled)"
    Write-Host "BadLogonCount: $($user.BadLogonCount)"
    Write-Host "LastBadPasswordAttempt: $($user.LastBadPasswordAttempt)"
    
    if ($user.LockedOut) {
        Unlock-ADAccount -Identity $Username
        Write-Host "Conta desbloqueada com sucesso!" -ForegroundColor Green
    }
    
    if (-not $user.Enabled) {
        Enable-ADAccount -Identity $Username
        Write-Host "Conta habilitada com sucesso!" -ForegroundColor Green
    }
}
catch {
    Write-Host "Erro: $($_.Exception.Message)" -ForegroundColor Red
}
